datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      // "MANAGER" | "EMPLOYEE"
  departmentId String?
  teamId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
  team         Team?       @relation(fields: [teamId], references: [id])
  reports      Report[]
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  
  teams       Team[]
  users       User[]
  projects    Project[]
}

model Team {
  id           String      @id @default(uuid())
  name         String
  departmentId String
  createdAt    DateTime    @default(now())

  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  projects     Project[]

  @@unique([departmentId, name])
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String
  departmentId String
  teamId       String
  status       String    @default("ON_TRACK") // "ON_TRACK" | "AT_RISK" | "DELAYED" | "COMPLETED"
  progress     Int       @default(0)          // 0 to 100
  priority     String    @default("MEDIUM")    // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  deadline     DateTime
  currentStage String    @default("Planning")  // "Planning" | "Development" | "Testing" | "Review" | "Deployed"
  lastUpdated  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stages       Stage[]
  reports      Report[]
  blockers     Blocker[]
}

model Stage {
  id          String    @id @default(uuid())
  projectId   String
  name        String    // "Planning", "Development", "Testing", "Review", "Deployed"
  order       Int       // 1, 2, 3, 4, 5
  status      String    @default("PENDING") // "COMPLETED" | "CURRENT" | "PENDING"
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Report {
  id              String    @id @default(uuid())
  projectId       String
  authorId        String
  stage           String
  progress        Int
  summary         String
  completedTasks  String    @default("[]") // JSON string of string[]
  risks           String    @default("[]") // JSON string of string[]
  peopleMentioned String    @default("[]") // JSON string of string[]
  nextMilestone   String?
  rawText         String
  fileName        String?
  fileUrl         String?
  createdAt       DateTime  @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id])
  blockers        Blocker[]
}

model Blocker {
  id          String   @id @default(uuid())
  projectId   String
  reportId    String?
  description String
  severity    String   @default("HIGH") // "LOW" | "MEDIUM" | "HIGH" | "BLOCKING"
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
}
