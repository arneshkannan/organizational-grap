# OrgGraph Frontend - Production Environment Variables
# If deploying on Vercel and connecting to a remote backend (e.g., Render, Railway, Fly.io, VPS):
# Set this to the public URL of your Express API backend:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Set this to the public WebSocket endpoint of your backend:
# VITE_WS_URL=wss://your-backend.onrender.com/ws
